# =============================
# Global ignore for photobooth_project
# =============================

# ---- Python ----
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
venv/
backend/venv/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Node / Frontend build ----
**/node_modules/
**/dist/
**/dist-ssr/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Local storage outputs (generated) ----
storage/temp_sessions/*
!storage/temp_sessions/.gitkeep
storage/final_outputs/*
!storage/final_outputs/.gitkeep

# ---- Camera/Windows metadata artifacts ----
*.Zone.Identifier

# ---- Editor / OS ----
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# 1. Bỏ qua tất cả ảnh chụp test (đuôi .jpg) ở bất kỳ thư mục nào
*.jpg

# 2. Bỏ qua các file rác hệ thống khi chép từ Windows sang
*:Zone.Identifier

# 3. Bỏ qua thư mục chứa data khách hàng (Cực kỳ quan trọng để bảo mật)
storage/fallback_contacts/